# ================================================================
# E-Commerce Backend — Environment Variables
# ================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit your real .env file to version control.
# ================================================================

# ── App ──────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000
LOG_LEVEL=info

# ── MongoDB ──────────────────────────────────────────────────────
# Local:  mongodb://localhost:27017/ecommerce
# Atlas:  mongodb+srv://<user>:<pass>@cluster.mongodb.net/ecommerce
MONGODB_URI=mongodb://localhost:27017/ecommerce

# ── Redis ────────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── JWT ──────────────────────────────────────────────────────────
# Generate strong secrets: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_use_a_long_random_hex_string_min_64_chars
JWT_EXPIRE=15m

# Separate secret makes refresh tokens independently revocable
JWT_REFRESH_SECRET=CHANGE_ME_different_long_random_hex_string_min_64_chars
JWT_REFRESH_EXPIRE=7d

# ── Email (SMTP) ─────────────────────────────────────────────────
# For development use Mailtrap: https://mailtrap.io
# For production use SendGrid / SES / Mailgun
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_mailtrap_user
SMTP_PASS=your_mailtrap_pass
FROM_NAME=ShopHub
FROM_EMAIL=noreply@shophub.com

# ── SMS / Twilio ─────────────────────────────────────────────────
# Leave blank to run in mock mode (OTP printed to console)
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Rate Limiting ────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ── Bcrypt ───────────────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12
